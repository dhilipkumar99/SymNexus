# Copy to .env (never commit .env).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Only these email domains can be given accounts (comma-separated).
ALLOWED_EMAIL_DOMAINS=symnexus.co
# Where the gateway is published. Keep it on localhost behind your TLS proxy.
GATEWAY_PUBLISH=127.0.0.1:8080
# Set to true behind a TLS-terminating proxy (Caddy, nginx, a load balancer).
TRUST_PROXY=false
# Set to true once the site is only served over HTTPS.
HSTS=false
