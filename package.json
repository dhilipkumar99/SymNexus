{
	"name": "symnexus-site",
	"private": true,
	"version": "1.0.0",
	"description": "Symnexus company website — PHP 8, Tailwind CSS, vanilla JS SPA router.",
	"scripts": {
		"build": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --minify",
		"watch": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --watch",
		"dev": "php -S localhost:8000 -t public api/index.php"
	},
	"devDependencies": {
		"tailwindcss": "^3.4.19"
	}
}
